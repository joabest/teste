ative; }
.solutions-section::before { position: absolute; top: 19%; left: -210px; width: 510px; height: 510px; border: 1px solid rgba(0,168,255,.065); border-radius: 50%; box-shadow: 0 0 0 54px rgba(0,168,255,.018), 0 0 0 108px rgba(0,168,255,.012); content: ''; pointer-events: none; }
.service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; scroll-margin-top: 90px; }
.service-card { position: relative; min-height: 222px; overflow: hidden; padding: 22px 20px 26px; border: 1px solid rgba(0,168,255,.15); background: var(--panel); transition: transform .25s var(--ease), border-color .25s ease, box-shadow .25s ease, background-color .25s ease; }
.service-card::before { position: absolute; inset: 0; opacity: 0; background: radial-gradient(230px circle at var(--pointer-x, 50%) var(--pointer-y, 50%), rgba(0,168,255,.12), transparent 58%); content: ''; transition: opacity .25s ease; pointer-events: none; }
.service-card:hover, .service-card:focus-within { z-index: 1; transform: translateY(-4px); border-color: rgba(0,168,255,.55); box-shadow: 0 12px 34px rgba(0,91,184,.12); }
.service-card:hover::before { opacity: 1; }
.service-card-top { position: relative; display: flex; align-items: center; justify-content: space-between; }
.service-number { display: flex; align-items: center; gap: 8px; color: var(--soft); font: 500 10px/1 'Space Grotesk', sans-serif; letter-spacing: .12em; }
.service-number i { width: 4px; height: 4px; border-radius: 50%; background: rgba(0,229,255,.75); }
.service-icon-frame { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid rgba(0,168,255,.2); background: rgba(0,102,255,.06); color: var(--cyan); transition: transform .3s var(--ease), background .3s ease; }
.service-card:hover .service-icon-frame { transform: rotate(-5deg) scale(1.06); background: rgba(0,102,255,.14); }
.service-icon { width: 21px; height: 21px; }
.service-card h3 { position: relative; max-width: 210px; margin: 22px 0 9px; font: 600 16px/1.25 'Space Grotesk', sans-serif; letter-spacing: -.025em; }
.service-card p { position: relative; max-width: 225px; margin: 0; color: var(--soft); font-size: 11px; line-height: 1.7; }
.service-card-line { position: absolute; bottom: 0; left: 20px; width: 40px; height: 1px; background: var(--neon); opacity: .48; transition: width .25s ease, opacity .25s ease; }
.service-card:hover .service-card-line { width: calc(100% - 40px); opacity: .7; }
.service-card-corner { position: absolute; right: 20px; bottom: 13px; color: var(--neon); font-size: 13px; opacity: .4; }

/* Control room */
.monitor-section { padding-top: 8px; }
.monitor-panel { position: relative; overflow: hidden; padding: 48px 52px 26px; border: 1px solid rgba(0,168,255,.24); background: radial-gradient(ellipse at 82% 10%, rgba(0,102,255,.12), transparent 38%), linear-gradient(125deg, rgba(6,20,38,.94), rgba(3,8,14,.97)); box-shadow: inset 0 0 50px rgba(0,102,255,.035); }
.monitor-panel::after { position: absolute; top: 0; right: 0; width: 170px; height: 130px; border-top: 1px solid rgba(0,229,255,.35); border-right: 1px solid rgba(0,229,255,.35); content: ''; pointer-events: none; }
.monitor-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
.monitor-header h2 { margin-top: 15px; font-size: clamp(39px, 4.6vw, 57px); }
.monitor-live { display: flex; align-items: center; gap: 9px; margin-top: 7px; color: rgba(226,239,250,.6); font: 500 9px/1 'Space Grotesk', sans-serif; letter-spacing: .13em; }
.monitor-body { display: grid; grid-template-columns: minmax(230px, .82fr) 1.5fr; gap: 18px; margin-top: 39px; }
.health-module { position: relative; display: flex; min-height: 310px; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 22px; border: 1px solid rgba(0,168,255,.19); background: rgba(0,8,17,.45); }
.module-label { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: rgba(222,237,250,.68); font: 500 9px/1 'Space Grotesk', sans-serif; letter-spacing: .13em; }
.module-label > span:first-child { color: var(--cyan); font-size: 8px; }
.health-value { position: relative; z-index: 1; font: 600 clamp(62px, 8vw, 90px)/.9 'Space Grotesk', sans-serif; letter-spacing: -.08em; }
.health-value span { margin-left: 3px; color: var(--cyan); font-size: .37em; vertical-align: top; }
.health-track { position: relative; z-index: 1; width: 100%; height: 2px; margin-top: -5px; background: rgba(146,174,204,.14); }
.health-track i { display: block; width: 98%; height: 100%; background: linear-gradient(90deg, var(--blue), var(--cyan)); box-shadow: 0 0 9px rgba(0,229,255,.55); }
.module-foot { position: relative; z-index: 1; display: flex; justify-content: space-between; color: var(--soft); font: 500 8px/1 'Space Grotesk', sans-serif; letter-spacing: .12em; }
.module-foot b { color: var(--cyan); font-weight: 500; }
.health-orbit { position: absolute; right: -62px; bottom: 18px; width: 190px; opacity: .45; transform: rotate(-50deg); }
.health-orbit circle { fill: none; stroke: rgba(0,168,255,.14); stroke-width: 1; }
.health-orbit .orbit-progress { stroke: var(--cyan); stroke-dasharray: 400 160; stroke-linecap: round; filter: drop-shadow(0 0 5px rgba(0,229,255,.4)); }
.monitor-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.metric-card { display: flex; min-height: 149px; flex-direction: column; justify-content: space-between; padding: 18px; border: 1px solid rgba(0,168,255,.15); background: rgba(0,8,17,.4); }
.metric-state { color: var(--cyan); font-size: 8px; letter-spacing: .08em; white-space: nowrap; }
.metric-graph { display: grid; gap: 8px; color: var(--soft); font: 500 8px/1 'Space Grotesk', sans-serif; letter-spacing: .09em; }
.metric-graph svg { width: 100%; height: 42px; overflow: visible; }
.metric-graph path { fill: none; stroke: var(--cyan); stroke-width: 1.4; stroke-dasharray: 6 4; animation: telemetry-trace 9s linear infinite; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 3px rgba(0,229,255,.4)); }
.metric-footnote { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--soft); font-size: 10px; }
.metric-footnote b { color: rgba(229,242,252,.8); font: 500 8px/1 'Space Grotesk', sans-serif; letter-spacing: .08em; }
.tiny-lock { color: var(--cyan); font-size: 9px; }
.backup-progress { display: flex; align-items: center; gap: 4px; height: 28px; }
