function ContactControl({ children, className, label, onFallback }: { children: import('react').ReactNode; className: string; label: string; onFallback: () => void }) {
  if (contactUrl) return <a className={className} href={contactUrl} target="_blank" rel="noopener noreferrer" aria-label={label}>{children}</a>;
  return <button className={className} type="button" onClick={onFallback} aria-label={label}>{children}</button>;
}

